# ---------------------------------------------------------------------------
# TeamAgents configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# HTTP
PORT=4000
HOST=0.0.0.0
# Origins the browser loads the web app from (comma-separated; CORS + sockets).
WEB_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/teamagents

# Secrets ---------------------------------------------------------------------
# Signs session JWTs. Change this.
JWT_SECRET=dev-only-change-me-jwt-secret
# Encrypts git credentials at rest (AES-256-GCM). Change this. Losing it makes
# every stored credential unrecoverable.
TEAMAGENTS_SECRET=dev-only-change-me-credential-encryption-secret

# Storage ---------------------------------------------------------------------
# Root for uploads and agent sandboxes. Relative paths resolve from repo root.
DATA_DIR=./data
# Max upload size in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400

# Agent harnesses -------------------------------------------------------------
# Absolute paths to the harness CLIs. Leave blank to auto-discover on PATH.
CLAUDE_BIN=
CODEX_BIN=
OPENCODE_BIN=

# Sandboxing ------------------------------------------------------------------
# Path to bubblewrap. Leave blank to auto-discover.
BWRAP_BIN=
# Set to `false` to run harnesses WITHOUT bubblewrap (not recommended; only for
# environments where unprivileged user namespaces are unavailable).
SANDBOX_ENABLED=true

# Credentials passed through to the harnesses inside the sandbox. Whichever of
# these are set are forwarded to the agent process.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Pins the model OpenCode uses inside sandboxes, as `provider/model`
# (e.g. opencode/deepseek-v4-flash). Leave blank to use OpenCode's default.
OPENCODE_MODEL=

# Share package/tool caches between sandboxes of the same harness. Sandboxes are
# permanent, so without this each one keeps its own copy of everything its
# harness downloads (close to 1 GB per OpenCode session).
SHARE_AGENT_CACHES=true

# Where harness logins are read from when seeding a sandbox. Blank means the
# server user's home directory. Docker sets this to a read-only mount instead.
HARNESS_CREDENTIALS_DIR=

# Built web assets served alongside the API. Blank means apps/web/dist.
WEB_DIST=

# --- Docker only -------------------------------------------------------------
# uid:gid the container runs as, so read-only credential mounts are readable.
TEAMAGENTS_UID=1000
TEAMAGENTS_GID=1000
# Set to false to build an image without the agent CLIs.
INSTALL_HARNESSES=true
